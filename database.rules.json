{
  "rules": {
    ".read": false,
    ".write": false,
    "classes": {
      "$class": {
        "info": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com'",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && !data.exists() && newData.exists() && newData.child('owner').val() === auth.uid && $class.matches(/^[A-F0-9]{12}$/)",
          ".validate": "newData.hasChildren(['owner','name','created'])",
          "owner": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "created": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('classes').child($class).child('info/owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && ($uid === auth.uid || (root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true))",
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (root.child('classes').child($class).child('info/owner').val() === auth.uid || ($uid === auth.uid && newData.val() === true && root.child('classes').child($class).child('info').exists()))",
            ".validate": "newData.val() === true"
          }
        },
        "requests": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('classes').child($class).child('info/owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && ($uid === auth.uid || root.child('classes').child($class).child('info/owner').val() === auth.uid)",
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('classes').child($class).child('info').exists() && (($uid === auth.uid && !root.child('classes').child($class).child('members').child(auth.uid).exists()) || root.child('classes').child($class).child('info/owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "notice": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('classes').child($class).child('info/owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "presence": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true)",
          "$uid": {
            "$session": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $uid === auth.uid && ((root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true) || !newData.exists())",
              ".validate": "newData.hasChildren(['name','map','x','y','dir','moving','av','page','at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
              },
              "map": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "dir": {
                ".validate": "newData.val() === 'up' || newData.val() === 'down' || newData.val() === 'left' || newData.val() === 'right'"
              },
              "moving": {
                ".validate": "newData.isBoolean()"
              },
              "page": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4 && newData.val() % 1 === 0"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "av": {
                ".validate": "newData.hasChildren(['gender','hair','face','hairColor','cloth','acc','shoes'])",
                "gender": {
                  ".validate": "newData.val() === 'boy' || newData.val() === 'girl'"
                },
                "hair": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
                },
                "face": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
                },
                "hairColor": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
                },
                "cloth": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
                },
                "acc": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
                },
                "shoes": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "tower": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true)",
          "config": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('classes').child($class).child('info/owner').val() === auth.uid && newData.exists()",
            ".validate": "newData.hasChildren(['runId','at'])",
            "runId": {
              ".validate": "newData.isString() && newData.val().matches(/^[-A-Za-z0-9_]{20}$/)"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          },
          "runs": {
            "$run": {
              "hits": {
                "$uid": {
                  "$hit": {
                    ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true) && $uid === auth.uid && root.child('classes').child($class).child('tower/config/runId').val() === $run && !data.exists() && newData.exists()",
                    ".validate": "newData.hasChildren(['floor','stat','power','name','at']) && newData.parent().parent().parent().child('cooldowns').child($uid).child('key').val() === $hit && newData.parent().parent().parent().child('cooldowns').child($uid).child('at').val() === now && (!root.child('classes').child($class).child('tower/runs').child($run).child('cooldowns').child($uid).child('at').exists() || now - root.child('classes').child($class).child('tower/runs').child($run).child('cooldowns').child($uid).child('at').val() >= 1500)",
                    "floor": {
                      ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0"
                    },
                    "stat": {
                      ".validate": "newData.isString() && newData.val().matches(/^(observation|persistence|cooperation|knowledge|creativity|vitality)$/)"
                    },
                    "power": {
                      ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30 && newData.val() % 1 === 0"
                    },
                    "name": {
                      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
                    },
                    "at": {
                      ".validate": "newData.isNumber() && newData.val() === now"
                    },
                    "$other": {
                      ".validate": false
                    }
                  }
                }
              },
              "cooldowns": {
                "$uid": {
                  ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && (root.child('classes').child($class).child('info/owner').val() === auth.uid || root.child('classes').child($class).child('members').child(auth.uid).val() === true) && $uid === auth.uid && root.child('classes').child($class).child('tower/config/runId').val() === $run && newData.exists()",
                  ".validate": "newData.hasChildren(['key','at']) && (!data.exists() || now - data.child('at').val() >= 1500) && newData.parent().parent().child('hits').child($uid).child(newData.child('key').val()).child('at').val() === now",
                  "key": {
                    ".validate": "newData.isString() && newData.val().matches(/^[-A-Za-z0-9_]{20}$/)"
                  },
                  "at": {
                    ".validate": "newData.isNumber() && newData.val() === now"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "awards": {
            "$uid": {
              "$title": {
                ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && root.child('classes').child($class).child('info/owner').val() === auth.uid && newData.exists()",
                ".validate": "$title.matches(/^mentor-(observation|persistence|cooperation|knowledge|creativity|vitality)$/) && newData.isBoolean()"
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
